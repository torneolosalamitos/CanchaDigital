rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function myUser() {
      return signedIn() && exists(userPath(request.auth.uid))
        ? get(userPath(request.auth.uid)).data
        : {};
    }

    function isOwner() {
      return signedIn() &&
        (
          request.auth.token.email == 'edanchra@gmail.com' ||
          request.auth.token.email == 'Edanchra@gmail.com' ||
          request.auth.token.email == 'admincanchadigital@gmail.com'
        );
    }

    function isAdmin() {
      return signedIn() && myUser().role == 'admin';
    }

    function isCaptain() {
      return signedIn() && myUser().role == 'captain';
    }

    function scopedTorneo(data) {
      return data.torneo;
    }

    function scopedCat(data) {
      return data.cat;
    }

    function adminScopeHas(torneo, cat) {
      return isAdmin() &&
        myUser().adminScope is map &&
        torneo in myUser().adminScope &&
        myUser().adminScope[torneo] is map &&
        myUser().adminScope[torneo][cat] == true;
    }

    function adminCanAccess(data) {
      return isOwner() || adminScopeHas(scopedTorneo(data), scopedCat(data));
    }

    function businessRole(businessId) {
      return signedIn() &&
        myUser().businessRoles is map &&
        businessId in myUser().businessRoles &&
        myUser().businessRoles[businessId] is map
          ? myUser().businessRoles[businessId].role
          : '';
    }

    function businessMember(businessId) {
      return isOwner() || businessRole(businessId) in ['owner', 'box_admin', 'trainer', 'auditor'];
    }

    function businessWriter(businessId) {
      return isOwner() || businessRole(businessId) in ['owner', 'box_admin', 'trainer'];
    }

    function businessMoneyManager(businessId) {
      return isOwner() || businessRole(businessId) in ['owner', 'box_admin'];
    }

    function businessTrainer(businessId) {
      return businessRole(businessId) == 'trainer';
    }

    function businessAuditor(businessId) {
      return businessRole(businessId) == 'auditor';
    }

    function isBoxBusiness(businessId) {
      return businessId == 'box-lombardo-toledano';
    }

    function boxDocHasBusiness(data, businessId) {
      return data.businessId == businessId;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (isOwner() || isAdmin() || request.auth.uid == uid);
      allow create: if signedIn() && (isOwner() || request.auth.uid == uid);
      allow update: if signedIn() && (
        isOwner() ||
        (
          request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.businessRoles == resource.data.businessRoles &&
          request.resource.data.adminScope == resource.data.adminScope
        ) ||
        false
      );
      allow delete: if isOwner();
    }

    match /equipos/{id} {
      allow read: if true;
      allow create, update: if signedIn() && (
        adminCanAccess(request.resource.data) ||
        (isCaptain() && myUser().equipoKey == id)
      );
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /partidos/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /inscripciones/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /pagos/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /productos/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn() && (isOwner() || isAdmin());
    }

    match /ventas/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /gastosTienda/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /turnos/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /arbitros/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /trabajadores/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /gastosTrab/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /solicitudes/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        isOwner() ||
        adminCanAccess(resource.data) ||
        adminCanAccess(request.resource.data) ||
        isCaptain()
      );
      allow delete: if signedIn() && (
        isOwner() ||
        adminCanAccess(resource.data) ||
        isCaptain()
      );
    }

    match /mercadotecnia/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /temporadas/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /categorias/{id} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /usuarios_autorizados/{id} {
      allow read, write: if isOwner();
    }

    match /bot_sessions/{id} {
      allow read, write: if isOwner();
    }

    match /businesses/{businessId} {
      allow read: if isBoxBusiness(businessId);
      allow create, update: if isBoxBusiness(businessId) && businessMoneyManager(businessId);
      allow delete: if false;

      match /prospects/{id} {
        allow read: if businessMoneyManager(businessId);
        allow create: if isBoxBusiness(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId) &&
          request.resource.data.contactConsent == true;
        allow update: if businessWriter(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId);
        allow delete: if false;
      }

      match /members/{id} {
        allow read: if businessMember(businessId);
        allow create: if businessWriter(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId);
        allow update: if businessWriter(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId) &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /guardians/{id} {
        allow read: if businessWriter(businessId) || businessAuditor(businessId);
        allow create, update: if businessWriter(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId);
        allow delete: if false;
      }

      match /groups/{id} {
        allow read: if businessMember(businessId);
        allow create, update: if businessMoneyManager(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId);
        allow delete: if false;
      }

      match /sessions/{id} {
        allow read: if businessMember(businessId);
        allow create, update: if businessWriter(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId) &&
          request.resource.data.status in ['open', 'closed', 'corrected'];
        allow delete: if false;
      }

      match /attendance/{id} {
        allow read: if businessMember(businessId);
        allow create, update: if businessWriter(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId) &&
          request.resource.data.status in ['present', 'absent', 'justified_absence', 'trial_class', 'late', 'early_leave'];
        allow delete: if false;
      }

      match /expenses/{id} {
        allow read: if businessMoneyManager(businessId) || businessAuditor(businessId);
        allow create: if businessMoneyManager(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId) &&
          request.resource.data.paymentMethod == 'cash';
        allow update: if businessMoneyManager(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId);
        allow delete: if false;
      }

      match /physicalAudits/{id} {
        allow read: if businessMoneyManager(businessId) || businessAuditor(businessId);
        allow create, update: if businessMoneyManager(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId);
        allow delete: if false;
      }

      match /inconsistencies/{id} {
        allow read: if businessMember(businessId);
        allow create, update: if businessWriter(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId);
        allow delete: if false;
      }

      match /notifications/{id} {
        allow read: if businessMember(businessId);
        allow create, update, delete: if false;
      }

      match /billingPeriods/{id} {
        allow read: if businessMember(businessId);
        allow create, update, delete: if false;
      }

      match /charges/{id} {
        allow read: if businessMember(businessId);
        allow create, update, delete: if false;
      }

      match /payments/{id} {
        allow read: if businessMoneyManager(businessId) ||
          businessAuditor(businessId) ||
          (businessTrainer(businessId) && resource.data.receivedByUserId == request.auth.uid);
        allow create, update, delete: if false;
      }

      match /cashDeliveries/{id} {
        allow read: if businessMoneyManager(businessId) ||
          businessAuditor(businessId) ||
          (businessTrainer(businessId) && resource.data.deliveredByUserId == request.auth.uid);
        allow create, update, delete: if false;
      }

      match /cashClosings/{id} {
        allow read: if businessMoneyManager(businessId) || businessAuditor(businessId);
        allow create, update, delete: if false;
      }

      match /auditLogs/{id} {
        allow read: if businessMoneyManager(businessId) || businessAuditor(businessId);
        allow create: if businessWriter(businessId) &&
          boxDocHasBusiness(request.resource.data, businessId) &&
          request.resource.data.actorUserId == request.auth.uid;
        allow update, delete: if false;
      }

      match /settings/{id} {
        allow read: if businessMember(businessId);
        allow create, update, delete: if false;
      }
    }
  }
}
