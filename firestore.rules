rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function myUser() {
      return signedIn() && exists(userPath(request.auth.uid))
        ? get(userPath(request.auth.uid)).data
        : {};
    }

    function isOwner() {
      return signedIn() &&
        (
          request.auth.token.email == 'edanchra@gmail.com' ||
          request.auth.token.email == 'Edanchra@gmail.com' ||
          request.auth.token.email == 'admincanchadigital@gmail.com'
        );
    }

    function isAdmin() {
      return signedIn() && myUser().role == 'admin';
    }

    function isCaptain() {
      return signedIn() && myUser().role == 'captain';
    }

    function scopedTorneo(data) {
      return data.torneo;
    }

    function scopedCat(data) {
      return data.cat;
    }

    function adminScopeHas(torneo, cat) {
      return isAdmin() &&
        myUser().adminScope is map &&
        torneo in myUser().adminScope &&
        myUser().adminScope[torneo] is map &&
        myUser().adminScope[torneo][cat] == true;
    }

    function adminCanAccess(data) {
      return isOwner() || adminScopeHas(scopedTorneo(data), scopedCat(data));
    }


    match /{document=**} {
      allow read, write: if false;
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (isOwner() || isAdmin() || request.auth.uid == uid);
      allow create: if signedIn() && (isOwner() || request.auth.uid == uid);
      allow update: if signedIn() && (
        isOwner() ||
        (
          request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.adminScope == resource.data.adminScope
        ) ||
        false
      );
      allow delete: if isOwner();
    }

    match /equipos/{id} {
      allow read: if true;
      allow create, update: if signedIn() && (
        adminCanAccess(request.resource.data) ||
        (isCaptain() && myUser().equipoKey == id)
      );
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /partidos/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /inscripciones/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /pagos/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /productos/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn() && (isOwner() || isAdmin());
    }

    match /ventas/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /gastosTienda/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /turnos/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /arbitros/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /trabajadores/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /gastosTrab/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /solicitudes/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        isOwner() ||
        adminCanAccess(resource.data) ||
        adminCanAccess(request.resource.data) ||
        isCaptain()
      );
      allow delete: if signedIn() && (
        isOwner() ||
        adminCanAccess(resource.data) ||
        isCaptain()
      );
    }

    match /mercadotecnia/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /temporadas/{id} {
      allow read: if true;
      allow create, update: if signedIn() && adminCanAccess(request.resource.data);
      allow delete: if signedIn() && adminCanAccess(resource.data);
    }

    match /categorias/{id} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /usuarios_autorizados/{id} {
      allow read, write: if isOwner();
    }

    match /bot_sessions/{id} {
      allow read, write: if isOwner();
    }

    match /audit_logs/{id} {
      allow read: if signedIn() && (isOwner() || adminCanAccess(resource.data));
      allow create: if signedIn() && adminCanAccess(request.resource.data);
      allow update, delete: if isOwner();
    }

  }
}
